PORT=3001
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Set DB_TYPE to either "mongodb" or "mysql"
DB_TYPE=mongodb

# MongoDB (when DB_TYPE=mongodb)
MONGODB_URI=mongodb://127.0.0.1:27017/affiliate_hub

# MySQL (when DB_TYPE=mysql) - for cPanel hosting
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=affiliate_hub
MYSQL_USER=your_cpanel_username
MYSQL_PASSWORD=your_password
# Set to 'true' to sync models on startup (use only in development)
MYSQL_SYNC=false
