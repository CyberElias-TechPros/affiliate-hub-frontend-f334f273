PORT=3001
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ==================== DATABASE CONFIG ====================

# Primary database: "mongodb", "mysql", or "postgres"
DB_TYPE=mongodb

# ---- MongoDB (default) ----
MONGODB_URI=mongodb://127.0.0.1:27017/affiliate_hub

# ---- MySQL (for cPanel hosting) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=affiliate_hub
MYSQL_USER=your_cpanel_username
MYSQL_PASSWORD=your_password
MYSQL_SYNC=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=affiliate_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# ==================== SYNC (Backup Redundancy) ====================

# Enable multi-database sync for backup redundancy
# When enabled, all databases stay in sync with last-write-wins
ENABLE_SYNC=false

# Sync to MySQL (requires DB_TYPE=mongodb or postgres)
SYNC_MYSQL=false

# Sync to PostgreSQL (requires DB_TYPE=mongodb or mysql)
SYNC_POSTGRES=false

# Primary DB for writes (all writes go here first)
PRIMARY_DB=mongodb

# Sync settings
SYNC_BATCH_SIZE=100
SYNC_INTERVAL=60000  # milliseconds (default: 1 minute)